# Combined API + model, for a single-container host such as Render.
#
# Kubernetes runs the two apart (Dockerfile.api + Dockerfile.model) so the heavy
# torch image scales separately. On a one-service host that split just doubles
# the bill, so this image leaves MODEL_SERVICE_URL unset and the gateway loads
# the model in-process -- the same path used in local development, not a
# deployment-only shortcut.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY requirements-model.txt requirements-api.txt ./
RUN pip install --no-cache-dir -r requirements-model.txt -r requirements-api.txt

COPY model/ ./model/
COPY api/ ./api/
COPY model_service/ ./model_service/
COPY data/news/ ./data/news/

# The nflverse parquet is gitignored, so it cannot be COPYed from a repo build.
# Fetch it at build time instead: the feature store is built at startup and
# would otherwise try to download into a read-only filesystem and crash-loop.
RUN python -c "\
import sys; sys.path.insert(0, 'model'); \
from data import load_weekly, load_schedules; \
years = list(range(2016, 2027)); \
load_weekly(years); load_schedules(years)"

RUN useradd --create-home --uid 10001 app && chown -R app:app /app
USER app

# Render supplies $PORT; default matches the other images for local runs.
ENV PORT=8000
EXPOSE 8000
CMD ["sh", "-c", "uvicorn api.main:app --host 0.0.0.0 --port ${PORT}"]
