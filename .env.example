# Copy to `.env` and fill in what you need:  cp .env.example .env
# Nothing here is required -- the stack runs end to end with none of it set.
# Each note says what you get when the variable is unset. `.env` is gitignored.

# Secrets -------------------------------------------------------------------

# Real LLM narration. Unset: a deterministic template. Same numbers either way,
# only the prose changes. Key from https://aistudio.google.com/apikey
# GOOGLE_API_KEY is accepted as an alias.
GEMINI_API_KEY=

# Narration model. Unset: gemini-2.5-flash
GEMINI_MODEL=

# Postgres + pgvector. Switches the feature store and retrieval onto Postgres.
# Unset: cached parquet and an in-process vector index.
# Compose stack: postgresql://gridiron:gridiron@postgres:5432/gridiron
DATABASE_URL=

# Service wiring ------------------------------------------------------------

# Where the gateway reaches the model service. Unset: loads the model
# in-process. Kubernetes and compose set this themselves.
MODEL_SERVICE_URL=

# Where the Next server reaches the gateway. Server-side only -- the browser
# always calls same-origin /api/*. Unset: http://localhost:8000
API_URL=

# Comma-separated CORS origins. Unset: http://localhost:3000
# Only matters for cross-origin browser calls; same-origin behind the ingress.
ALLOWED_ORIGINS=

# Frontend port. Unset: 3000
PORT=

# Feature store season range. Unset: 2016 and 2024.
FIRST_SEASON=
LAST_SEASON=

# Set elsewhere -------------------------------------------------------------
#
# GitHub Actions secrets: KUBE_CONFIG (base64 kubeconfig; unset skips the deploy
# step and CI still passes) and GITHUB_TOKEN (automatic).
#
#   kubectl create secret generic gridiron-secrets \
#     --from-literal=gemini-api-key="$GEMINI_API_KEY" \
#     --from-literal=database-url="$DATABASE_URL"
#
# Compose reads .env from the compose file's directory, so pass it explicitly:
#   docker compose --env-file .env -f infra/docker/compose.yaml up --build
