# ---------------------------------------------------------------------------
# Copy to `.env` and fill in what you need:  cp .env.example .env
#
# Nothing here is required. The stack runs end to end with this file absent --
# projections come from the trained model either way. Each variable turns on a
# path that is otherwise faked or defaulted, and the "Unset" note on each says
# exactly what you get without it.
#
# `.env` is gitignored. Never commit real values.
# ---------------------------------------------------------------------------


# === Secrets =================================================================

# Enables real LLM narration via the Gemini API (default model:
# gemini-2.5-flash). Unset: narration falls back to a deterministic template.
# The recommendation, the projections and the numbers are identical either way
# -- only the prose changes -- so this is a nice-to-have, not a dependency.
# Get one at https://aistudio.google.com/apikey
# GOOGLE_API_KEY is accepted as an alias if you already have that set.
GEMINI_API_KEY=

# Override the narration model. Unset: gemini-2.5-flash.
GEMINI_MODEL=

# Postgres + pgvector connection string. Switches BOTH the feature store and
# the news retrieval index onto Postgres.
# Unset: features are read from cached parquet and retrieval uses an in-process
# vector index. Everything still works.
# For the bundled compose stack, use:
#   postgresql://gridiron:gridiron@postgres:5432/gridiron
# (that user/password/db are hardcoded in infra/docker/compose.yaml, so they
# are not secrets -- change them there if you expose the database.)
DATABASE_URL=


# === Service wiring ==========================================================

# Where the API gateway reaches the model service.
# Unset: the gateway loads the model in-process instead -- convenient locally,
# and the reason a single `uvicorn api.main:app` is enough to run everything.
# Kubernetes and compose set this themselves; you only need it if you run the
# two services split by hand.
#   MODEL_SERVICE_URL=http://localhost:8001
MODEL_SERVICE_URL=

# Where the Next server reaches the gateway. Server-side only -- the browser
# always calls same-origin /api/*, which the ingress (in Kubernetes) or
# frontend/app/api/[...path]/route.ts proxies onward.
# Unset: http://localhost:8000
# Do not point this at a browser-reachable address expecting the client to use
# it; it is read per request by the Next server, not baked into the bundle.
API_URL=

# Comma-separated CORS origins accepted by the gateway.
# Unset: http://localhost:3000
# Only matters when a browser calls the API cross-origin. Deployed behind the
# ingress everything is same-origin, so this stays empty in practice.
#   ALLOWED_ORIGINS=http://localhost:3000,https://gridiron.example.com
ALLOWED_ORIGINS=

# Port the frontend listens on. Unset: 3000
PORT=


# === Data range ==============================================================

# Seasons loaded into the feature store. Unset: 2016 and 2024.
# Narrow the range to cut startup time and memory; widen it only if you have
# the matching parquet cached in data/raw/.
FIRST_SEASON=
LAST_SEASON=


# ---------------------------------------------------------------------------
# NOT set through this file
# ---------------------------------------------------------------------------
#
# GitHub Actions secrets (Settings > Secrets and variables > Actions):
#   KUBE_CONFIG    base64-encoded kubeconfig for the deploy job. Unset: images
#                  are built and pushed, the deploy step is skipped and CI
#                  still goes green.
#                    base64 -i ~/.kube/config | pbcopy
#   GITHUB_TOKEN   provided automatically by Actions. Nothing to do.
#
# Kubernetes reads the two secrets above from a Secret named `gridiron-secrets`
# (both keys optional -- absent means the same fallbacks described above):
#   kubectl create secret generic gridiron-secrets \
#     --from-literal=gemini-api-key="$GEMINI_API_KEY" \
#     --from-literal=database-url="$DATABASE_URL"
#
# Docker Compose loads `.env` from the compose file's own directory, not the
# repo root, so pass this one explicitly:
#   docker compose --env-file .env -f infra/docker/compose.yaml up --build
